rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && profile().status == "active";
    }

    function admin() {
      return activeUser()
        && profile().role in ["ADMIN", "SUPER_ADMIN", "OPERATIONS"];
    }

    function superAdmin() {
      return activeUser()
        && profile().role == "SUPER_ADMIN";
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || superAdmin();
      allow create, delete: if false;
      allow update: if superAdmin();
    }

    match /products/{id} { allow read, write: if admin(); }
    match /salesProducts/{id} { allow read, write: if admin(); }
    match /inventoryAdjustments/{id} { allow read, write: if admin(); }
    match /growingBatches/{id} { allow read, write: if admin(); }
    match /locations/{id} { allow read, write: if admin(); }
    match /subscriptions/{id} { allow read, write: if admin(); }
    match /subscriptionPlans/{id} { allow read, write: if admin(); }
    match /deliveryCharges/{id} { allow read, write: if admin(); }
    match /customers/{id} { allow read, write: if admin(); }
    match /orders/{id} { allow read, write: if admin(); }
    match /enquiries/{id} { allow read, write: if admin(); }
    match /deliveryUsers/{id} { allow read, write: if admin(); }
    match /deliveryAssignments/{id} { allow read, write: if admin(); }
    match /subscriptionDeliveries/{id} { allow read, write: if admin(); }
    match /fulfilments/{id} { allow read, write: if admin(); }

    match /cmsPages/{id} { allow read, write: if admin(); }
    match /cmsFaq/{id} { allow read, write: if admin(); }
    match /cmsTestimonials/{id} { allow read, write: if admin(); }
    match /cmsBlogs/{id} { allow read, write: if admin(); }
    match /cmsBanners/{id} { allow read, write: if admin(); }
    match /cmsNavigation/{id} { allow read, write: if admin(); }
    match /cmsSiteSettings/{id} { allow read, write: if admin(); }

    match /notifications/{id} {
      allow read, write: if admin();
      allow read: if signedIn() && (
        resource.data.recipientUid == request.auth.uid
        || (
          resource.data.recipientCustomerId is string
          && exists(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId))
          && (
            get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids is list
              && get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids.hasAny([request.auth.uid])
            )
          )
        )
      );
      allow update: if signedIn()
        && (
          resource.data.recipientUid == request.auth.uid
          || (
            resource.data.recipientCustomerId is string
            && exists(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId))
            && (
              get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUid == request.auth.uid
              || (
                get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids is list
                && get(/databases/$(database)/documents/customers/$(resource.data.recipientCustomerId)).data.authUids.hasAny([request.auth.uid])
              )
            )
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    match /customerPushSubscriptions/{id} {
      allow read, write: if admin();
      allow read: if signedIn() && resource.data.authUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.customerId is string
        && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
        && (
          get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUid == request.auth.uid
          || (
            get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUids is list
            && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.authUids.hasAny([request.auth.uid])
          )
        );
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.token == resource.data.token;
      allow delete: if signedIn() && resource.data.authUid == request.auth.uid;
    }
    match /auditEvents/{id} { allow read, write: if admin(); }

    match /websiteTrustPoints/{id} { allow read, write: if admin(); }
    match /websiteJourneyContent/{id} { allow read, write: if admin(); }
    match /seedlingsFeedback/{id} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}